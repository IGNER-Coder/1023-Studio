# Sanity project credentials
# Find these in manage.sanity.io → your project → Settings → API
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity read token (required for server-side fetching)
# Generate at manage.sanity.io → API → Tokens → Add API Token (Viewer role)
SANITY_API_READ_TOKEN=

# Resend API key for contact form email delivery
# Get at resend.com → API Keys
RESEND_API_KEY=
